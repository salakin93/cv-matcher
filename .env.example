# Copy this file to .env and replace every placeholder before starting locally.
DB_URL=jdbc:postgresql://localhost:5430/cv-matcher
DB_USERNAME=salaco
DB_PASSWORD=replace-with-your-local-database-password
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# Example-only Base64 AES-256 key. Replace it with a unique secret that decodes to 16, 24, or 32 bytes.
IDENTITY_OUTBOX_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
IDENTITY_OUTBOX_ENCRYPTION_KEY_VERSION=1
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set this to the VITE_FRONTEND_ORIGIN in cv-matcher-frontend/.env.
CORS_ALLOWED_ORIGINS=replace-with-your-vite-frontend-origin
