{
  "info": {
    "_postman_id": "b521a42d-ec1e-4cd4-8d83-11620f9b8032",
    "name": "CV Matcher API",
    "description": "Coleccion para los endpoints implementados de identidad y salud. Configure los tokens de verificacion o restablecimiento que reciba por el canal de correo configurado. No agregue secretos al archivo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:6060"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": "",
      "description": "Valor de la cookie XSRF-TOKEN para refresh y logout. Postman puede conservarla en su cookie jar; si no, copie su valor aqui."
    },
    {
      "key": "fullName",
      "value": "Usuario de Prueba"
    },
    {
      "key": "email",
      "value": "reclutador.prueba@example.test"
    },
    {
      "key": "password",
      "value": "ClaveSegura1"
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "passwordResetToken",
      "value": ""
    },
    {
      "key": "emailChangeToken",
      "value": ""
    },
    {
      "key": "newEmail",
      "value": "reclutador.nuevo@example.test"
    },
    {
      "key": "newPassword",
      "value": "NuevaClaveSegura1"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userVersion",
      "value": "0"
    },
    {
      "key": "vacancyId",
      "value": ""
    },
    {
      "key": "vacancyVersion",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public authentication",
      "item": [
        {
          "name": "Register recruiter",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend email verification",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/resend-verification"
          }
        },
        {
          "name": "Confirm email verification",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-email"
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Authenticated identity",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Account security",
      "item": [
        {
          "name": "Request password reset",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/auth/password-reset/request"
          }
        },
        {
          "name": "Confirm password reset",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"token\": \"{{passwordResetToken}}\",\n  \"password\": \"{{newPassword}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/auth/password-reset/confirm"
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"password\": \"{{newPassword}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/auth/password/change"
          }
        },
        {
          "name": "Request email change",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"email\": \"{{newEmail}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/auth/email-change/request"
          }
        },
        {
          "name": "Resend email change",
          "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/auth/email-change/resend"}
        },
        {
          "name": "Confirm email change",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"token\": \"{{emailChangeToken}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/auth/email-change/verify"
          }
        }
      ]
    },
    {
      "name": "Administration",
      "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
      "item": [
        {
          "name": "List users",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/admin/users?offset=0&limit=50"}
        },
        {
          "name": "Update another user",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"role\": \"RECRUITER\",\n  \"active\": true,\n  \"version\": {{userVersion}}\n}"},
            "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Vacancies",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create vacancy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ingeniero de software\",\n  \"description\": \"Desarrolla servicios para el equipo de producto.\",\n  \"receptionStart\": \"2026-09-01\",\n  \"receptionEnd\": \"2026-09-30\",\n  \"requirements\": [\n    {\n      \"description\": \"Java y Spring Boot\",\n      \"weight\": 5,\n      \"mandatory\": true\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/vacancies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('vacancyId', body.id);",
                  "pm.collectionVariables.set('vacancyVersion', String(body.version));"
                ]
              }
            }
          ]
        },
        {
          "name": "List vacancies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/vacancies"
          }
        },
        {
          "name": "Get vacancy",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/vacancies/{{vacancyId}}"
          }
        },
        {
          "name": "Replace vacancy",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{vacancyVersion}},\n  \"title\": \"Ingeniero de software senior\",\n  \"description\": \"Desarrolla y mantiene servicios para el producto.\",\n  \"receptionStart\": \"2026-09-01\",\n  \"receptionEnd\": \"2026-09-30\",\n  \"requirements\": [\n    {\n      \"description\": \"Java y Spring Boot\",\n      \"weight\": 5,\n      \"mandatory\": true\n    },\n    {\n      \"description\": \"PostgreSQL\",\n      \"weight\": 3,\n      \"mandatory\": false\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/vacancies/{{vacancyId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('vacancyVersion', String(pm.response.json().version));"
                ]
              }
            }
          ]
        },
        {
          "name": "Archive vacancy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{vacancyVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/v1/vacancies/{{vacancyId}}/archive"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('vacancyVersion', String(pm.response.json().version));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reactivate vacancy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{vacancyVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/v1/vacancies/{{vacancyId}}/reactivate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('vacancyVersion', String(pm.response.json().version));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
